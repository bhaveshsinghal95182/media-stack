# Copy to .env, fill in, then: chmod 600 .env
# SETUP.md explains where each value comes from.

# --- You ---------------------------------------------------------------
# Your user and group id: run `id -u` and `id -g`.
PUID=1000
PGID=1000
# Your timezone: run `timedatectl show -p Timezone --value`.
TZ=Asia/Kolkata

# --- qBittorrent (SETUP.md step 5) --------------------------------------
# The Web UI login you set in qBittorrent -> Options -> WebUI.
QBIT_USERNAME=
QBIT_PASSWORD=

# --- Radarr / Sonarr (SETUP.md steps 6 and 7) ----------------------------
# Settings -> General -> Security -> API Key in each app.
RADARR_API_KEY=
SONARR_API_KEY=

# --- Media library web page (http://<LAN IP>:8099) ----------------------
# Login for the page. Leave LIBRARY_USERNAME empty to accept any username.
# Pick a long password: `openssl rand -base64 12` makes one.
# If it contains a $, wrap it in single quotes.
LIBRARY_USERNAME=
LIBRARY_PASSWORD=
# Optional: Jellyfin -> Dashboard -> API Keys. Used to see what has been watched
# (automatic cleanup). Empty = reuse the key Seerr created in Jellyfin.
JELLYFIN_API_KEY=
# Jellyfin account that "Hide on TV" blocks shows for. Empty = tv.
TV_USER=
# Folder the Import tab may browse (read-only). Only video and subtitle
# files are ever listed.
IMPORT_DIR=/home/your-user/Downloads

# gpuswitch: Jellyfin API key for the AC/battery transcoding switch
# (Jellyfin -> Dashboard -> API Keys -> + "gpuswitch").
JELLYFIN_GPUSWITCH_API_KEY=
# Transcoding hardware on AC power: qsv (Intel) or nvenc (needs
# nvidia-container-toolkit; see SETUP.md). Battery always uses qsv.
JELLYFIN_AC_HWACCEL=qsv
